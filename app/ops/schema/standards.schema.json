{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "基準値",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "change": {
      "description": "変更管理の基準",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_approvals"
      ],
      "properties": {
        "required_approvals": {
          "description": "mainへの変更に要る承認の数",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "vulnerability": {
      "description": "脆弱性の基準",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_severity"
      ],
      "properties": {
        "fail_severity": {
          "description": "この重大度以上の脆弱性でゲートを失敗させる",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "exception": {
      "description": "例外の基準",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_days"
      ],
      "properties": {
        "max_days": {
          "description": "例外の期限として認める最長の日数",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "license": {
      "description": "ライセンスの基準",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "properties": {
        "allowed": {
          "description": "出荷する依存関係に許可するライセンス(SPDXの識別子)",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "description": "証跡の基準",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_days"
      ],
      "properties": {
        "retention_days": {
          "description": "証跡を消せない状態で保管する日数",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "change",
    "vulnerability",
    "exception",
    "license",
    "evidence"
  ]
}
